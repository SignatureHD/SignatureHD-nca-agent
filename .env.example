# HighLevel Marketplace app (My Apps > your app > Advanced Settings > Auth)
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_SHARED_SECRET=
GHL_REDIRECT_URI=https://YOUR-RAILWAY-DOMAIN/oauth/callback
# Long random string. Also pasted into the workflow action's header X-Action-Key
ACTION_KEY=
# Long random string that signs custom page sessions
SESSION_SECRET=
# Supabase: Project Settings > Database > Connection string (URI), use the pooler on port 6543
DATABASE_URL=postgresql+psycopg://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
RETENTION_DAYS=30
MOCK=0
